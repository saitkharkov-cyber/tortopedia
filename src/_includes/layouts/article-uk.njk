<!DOCTYPE html>
<html lang="uk-UA" prefix="og: http://ogp.me/ns#">
{% include "partials/head.njk" %}
<body class="post-template-default single single-post postid-{{ post_id }} single-format-standard group-blog">
<a class="skip-link" href="./#content">
Перейти до основного матеріалу
</a>
<div id="page" class="site">
{% include "partials/header-uk.njk" %}
<div class="container"><div id="content" class="site-content"><div id="crumbs"><a href="../">Головна</a> <span class="separator">&gt;</span> <a href="../category/{{ category_slug }}/">{{ category_title }}</a> <span class="separator">&gt;</span> <span class="current">{{ title | safe }}</span></div>
<div id="primary" class="content-area">
{% if post_id == 645 %}{% include "partials/recipe-schema-marshmallow-uk.njk" %}{% endif %}
<main id="main" class="site-main">
{{ content | safe }}
{% set autoNav = postNavigation | postNavigationFor(lang, page.url, collections.all) %}<nav class="navigation post-navigation" role="navigation">
<h2 class="screen-reader-text">Post navigation</h2>
<div class="nav-links">{% if autoNav.prev %}<div class="nav-previous"><a href="{{ autoNav.prev.url }}" rel="prev">{{ autoNav.prev.title | safe }}</a></div>{% elif prev_url %}<div class="nav-previous"><a href="{{ prev_url }}" rel="prev">{{ prev_title | safe }}</a></div>{% endif %}{% if autoNav.next %}<div class="nav-next"><a href="{{ autoNav.next.url }}" rel="next">{{ autoNav.next.title | safe }}</a></div>{% elif next_url %}<div class="nav-next"><a href="{{ next_url }}" rel="next">{{ next_title | safe }}</a></div>{% endif %}</div>
</nav>
</main>
</div>
{% include "partials/sidebar-uk.njk" %}
</div></div>
<footer id="colophon" class="site-footer">
<div class="container">
<div class="site-info d-flex">
<div class="copyright">
<span>
&copy;2026                <a href="../">Тортопедія</a>.
Всі права захищені.</span>
</div>
<div class="sitemap-of-site d-flex">
<a href="../html-sitemap/">Карта сайту</a>		</div>
</div>
</div>
</footer>
</div>
<script type='text/javascript' src='../../wp-content/themes/bakes-and-cakes/js/tab.js'></script>
<script type='text/javascript' src='../../wp-content/themes/bakes-and-cakes/js/sameheight.js'></script>
<script type='text/javascript' src='../../wp-content/themes/bakes-and-cakes/js/jquery.sidr.js'></script>
<script type='text/javascript'>
/* <![CDATA[ */
var bakes_and_cakes_data = {"auto":"1","loop":"1","pager":"1","animation":"slide","speed":"7000","a_speed":"600"};
/* ]]> */
</script>
<script type='text/javascript' src='../../wp-content/themes/bakes-and-cakes/js/custom.js'></script>
<script type='text/javascript' src='../../wp-includes/js/wp-embed.min.js'></script>
</body>
</html>
